# Copie este arquivo para ".env" na raiz do hub se quiser sobrescrever
# os padrões do docker compose. Não é obrigatório para subir o ambiente.

POSTGRES_USER=cesucacode
POSTGRES_PASSWORD=cesucacode
POSTGRES_DB=cesucacode

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-localmente

# URL que o navegador usa para falar com a API (não use o hostname Docker).
VITE_API_BASE_URL=http://localhost:8000

# --- Provedores de IA (obrigatório para upload/embeddings e chat RAG) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ABACUSAI_API_KEY=

# Ollama no host da máquina (não dentro do container).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# System prompt do chat (persona S.O.F.I.). Padrão do projeto; só mude se quiser outro arquivo.
# SYSTEM_PROMPT_PATH=apps/conversations/prompts/system_prompt.md
